# MongoDB (nythorion_node app database)
MONGO_URI=mongodb://nythorion:nythorion@localhost:27017/nythorion_node?authSource=admin

# PostgreSQL (nythorion_node_auth, used by Nythorion.Auth)
POSTGRES_CONNECTION_STRING=Host=localhost;Port=5432;Database=nythorion_node_auth;Username=nythorion;Password=nythorion

# Nythorion.Auth
AUTH_SERVER_URL=https://localhost:5001

# Nythorion.Api
API_PORT=3000

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text
