# MongoDB (nythorion_node app database) — native install, no auth by default
MONGO_URI=mongodb://localhost:27017/nythorion_node

# PostgreSQL (nythorion_node_auth, used by Nythorion.Auth) — use the superuser password set during install
POSTGRES_CONNECTION_STRING=Host=localhost;Port=5432;Database=nythorion_node_auth;Username=postgres;Password=changeme

# Nythorion.Auth
AUTH_SERVER_URL=http://localhost:5255

# Nythorion.Api
API_PORT=3000

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text
