@page
@model Nythorion.Auth.Pages.Connect.RegisterModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Nythorion — Register</title>
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: Roboto, sans-serif; background: #f5f5f5; display: flex; align-items: center; justify-content: center; min-height: 100vh; }
        .card { background: #fff; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,.12); padding: 2.5rem 2rem; width: 100%; max-width: 380px; }
        h1 { font-size: 1.4rem; font-weight: 500; margin-bottom: 1.5rem; color: #1a1a1a; }
        label { display: block; font-size: .875rem; color: #555; margin-bottom: .25rem; }
        input[type=text], input[type=password] { width: 100%; padding: .6rem .75rem; border: 1px solid #ccc; border-radius: 4px; font-size: 1rem; margin-bottom: 1rem; }
        input:focus { outline: none; border-color: #1976d2; box-shadow: 0 0 0 2px rgba(25,118,210,.2); }
        button { width: 100%; padding: .7rem; background: #1976d2; color: #fff; border: none; border-radius: 4px; font-size: 1rem; cursor: pointer; margin-bottom: 1rem; }
        button:hover { background: #1565c0; }
        .error { background: #fdecea; color: #b71c1c; border-radius: 4px; padding: .6rem .75rem; margin-bottom: 1rem; font-size: .875rem; }
        .errors ul { margin: 0; padding-left: 1.2rem; }
        .link { text-align: center; font-size: .875rem; color: #555; }
        .link a { color: #1976d2; text-decoration: none; }
    </style>
</head>
<body>
    <div class="card">
        <h1>Create account</h1>

        @if (Model.Errors.Any())
        {
            <div class="error errors">
                <ul>
                    @foreach (var error in Model.Errors)
                    {
                        <li>@error</li>
                    }
                </ul>
            </div>
        }

        <form method="post">
            <input type="hidden" asp-for="ReturnUrl" />
            <label asp-for="Input.Username">Username</label>
            <input type="text" asp-for="Input.Username" autocomplete="username" autofocus />
            <label asp-for="Input.Password">Password</label>
            <input type="password" asp-for="Input.Password" autocomplete="new-password" />
            <label asp-for="Input.ConfirmPassword">Confirm password</label>
            <input type="password" asp-for="Input.ConfirmPassword" autocomplete="new-password" />
            <button type="submit">Create account</button>
        </form>

        <p class="link"><a href="/Connect/Login?returnUrl=@Uri.EscapeDataString(Model.ReturnUrl ?? "")">Already have an account? Sign in</a></p>
    </div>
</body>
</html>
